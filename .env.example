# Browser-safe Supabase project settings. These values are embedded in the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret used by the controlled account-management actions.
# Configure it in Vercel; never prefix it with NEXT_PUBLIC_ or expose it to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the current deployment, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3003
